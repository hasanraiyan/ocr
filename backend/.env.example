# FastAPI Server Configuration
APP_NAME=DocuSense-API
ENVIRONMENT=local
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Local SQLite (default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./docusense.db
# Supabase / Neon PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Local upload directory (used for processing; also serves files locally when Supabase Storage is not set)
UPLOAD_DIR=./uploads

# Supabase Storage (optional for local dev, required on Render / any ephemeral host)
# Create a public bucket named "documents" in your Supabase project Storage tab first.
# SUPABASE_URL = Project URL from Settings > API (e.g. https://xxxx.supabase.co)
# SUPABASE_SERVICE_KEY = service_role key from Settings > API (not the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
